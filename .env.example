FOX_MASTER_KEY=
# Must be a Fernet key (see README). Docker Compose supplies a dev default if unset.
# Match docker-compose ClickHouse when the API runs on the host (compose CH uses password fox):
# FOX_CLICKHOUSE_PASSWORD=fox
# FOX_EXPORT_USE_CH_S3=true
# FOX_EXPORT_BATCH_SIZE=50000
# FOX_EXPORT_S3_PART_BYTES=8388608
#
# Ingest worker throughput (worker container reads these):
# FOX_WORKER_CONCURRENCY=4              # parallel Procrastinate jobs per worker process
# FOX_INGEST_FLUSH_ROWS=50000           # ClickHouse batch size
# FOX_INGEST_PROGRESS_EVERY=50000       # Postgres job progress update interval
# Scale workers: docker compose up -d --scale worker=2
#
# Local NL→DSL (llama.cpp server in compose). Override model download:
# LLM_MODEL_URL=https://huggingface.co/.../resolve/main/your-model.gguf
# LLM_MODEL_FILE=your-model.gguf
# LLM_MODEL_MIN_BYTES=400000000        # 0 = skip size check; lower if you use a smaller GGUF
# FOX_LLM_BASE_URL=http://llama-cpp:8080   # compose default; override for host/LM Studio/vLLM
# FOX_LLM_MODEL=local
# FOX_LLM_API_KEY=                         # Bearer token if your gateway requires it
# FOX_LLM_HEALTH_PATH=health               # or v1/models for OpenAI-style servers; "off" to skip probe
# FOX_LLM_ENABLED=false
